{
  "rewrites": [
    {
      "source": "/lb-api/(.*)",
      "destination": "/api/proxy?target=lb&rest=$1"
    },
    {
      "source": "/vm-api/(server-1|server-2|server-3)/(.*)",
      "destination": "/api/proxy?target=$1&rest=$2"
    },
    {
      "source": "/((?!api/|lb-api/|vm-api/).*)",
      "destination": "/index.html"
    }
  ]
}
